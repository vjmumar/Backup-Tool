generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  email               String               @unique
  name                String
  passwordHash        String
  freshSignIn         Boolean              @default(true)
  isActive            Boolean              @default(true)
  connectionLimit     Int                  @default(3)
  registeredPlatform  String               @default("kajabi") // "kajabi" | "kartra"
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  platformConnections PlatformConnection[]
}

// Singleton config document — only one record should ever exist
model AppConfig {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  kajabiIsMaintenance     Boolean  @default(false)
  kartraIsMaintenance     Boolean  @default(false)
  googleDriveClientId     String
  googleDriveClientSecret String

  // Kajabi-specific fields
  kajabiVersion           String   @default("")
  kajabiDownloadLink      String   @default("")
  kajabiSetupLink         String   @default("")
  kajabiPurchaseLink      String   @default("")

  // Kartra-specific fields
  kartraVersion           String   @default("")
  kartraDownloadLink      String   @default("")
  kartraSetupLink         String   @default("")
  kartraPurchaseLink      String   @default("")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model PlatformConnection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  lockId    String
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}
