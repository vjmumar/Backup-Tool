generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  email               String               @unique
  passwordHash        String
  freshSignIn         Boolean              @default(true)
  isActive            Boolean              @default(true)
  connectionLimit     Int                  @default(3)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  platformConnections PlatformConnection[]
}

// Singleton config document — only one record should ever exist
model AppConfig {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  version                 String   // e.g. "1.2.0" — clients compare their manifest version against this
  downloadLink            String   // download link for the current version
  isMaintenance           Boolean  @default(false)
  googleDriveClientId     String
  googleDriveClientSecret String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model PlatformConnection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  platform  String
  lockId    String
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}
