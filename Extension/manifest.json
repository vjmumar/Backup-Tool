{
  "manifest_version": 3,
  "name": "Course Backup",
  "version": "0.1.0",
  "description": "Backs up Kajabi courses to Google Drive.",
  "host_permissions": [
    "https://*.kajabi-cdn.com/*",
    "https://*.amazonaws.com/*",
    "https://*.kajabi.com/*"
  ],
  "permissions": ["storage", "identity", "downloads"],
  "icons": {
    "16":  "icon-transparent.png",
    "32":  "icon-transparent.png",
    "48":  "icon-transparent.png",
    "128": "icon-transparent.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Course Backup",
    "default_icon": {
      "16":  "icon-transparent.png",
      "32":  "icon-transparent.png",
      "48":  "icon-transparent.png",
      "128": "icon-transparent.png"
    }
  },
  "background": { "service_worker": "src/background/background.js", "type": "module" },
"key": "",
  "content_scripts": [
    {
      "matches": ["https://app.kajabi.com/admin/*"],
      "js": [
        "src/content/platformChecker.js",
        "src/content/ui.js",
        "src/content/modals/scraper.js",
        "src/content/modals/addPlatformConnection.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.kajabi.com/admin/*"],
      "js": ["src/content/bridge.js"],
      "run_at": "document_start"
    }
  ]
}
